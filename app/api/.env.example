# Servidor
CONNEXO_HTTP_ADDR=:8080
APP_ENV=development

# Banco de dados (local dev defaults — change for production)
CONNEXO_DATABASE_URL=postgres://connexo:connexo@localhost:15432/connexo?sslmode=disable

# Redis
CONNEXO_REDIS_URL=redis://localhost:6380

# JWT — required in production (APP_ENV=production). Use a long random value.
# Preferred name: JWT_SECRET. Alias: CONNEXO_JWT_SECRET.
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
# CONNEXO_JWT_SECRET=

# Storage de documentos (MinIO / S3-compatible)
# Preferred: MINIO_*. Alias: CONNEXO_STORAGE_*.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# CONNEXO_STORAGE_ENDPOINT=localhost:9000
# CONNEXO_STORAGE_ACCESS_KEY=minioadmin
# CONNEXO_STORAGE_SECRET_KEY=minioadmin
# CONNEXO_STORAGE_BUCKET=connexo-docs

# CORS (use * for local; set your domain in production)
CORS_ALLOWED_ORIGIN=*

# SMTP (optional — invite emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

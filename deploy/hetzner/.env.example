# Connexo — variáveis do deploy hetzner.
#
# Copie para .env NA RAIZ do checkout do servidor e preencha os segredos:
#   cp deploy/hetzner/.env.example .env
#
# O .env fica somente no servidor. Nunca comite — este repositório é público.

# --- Banco ---
CONNEXO_DB_USER=connexo
CONNEXO_DB_NAME=connexo
# openssl rand -hex 24
CONNEXO_DB_PASSWORD=

# --- Autenticação ---
# openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRY_HOURS=72

# --- MinIO ---
MINIO_ACCESS_KEY=connexo
# openssl rand -hex 24
MINIO_SECRET_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGIN=https://connexo.ad.vlog.br

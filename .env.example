# ============================================================
# Connexo — Environment Variables
# ============================================================
# Local stack (recommended): use app/docker-compose.yml which embeds
# local-dev defaults. For production compose:
#   cp .env.example .env
#   # edit secrets — never commit .env
#   docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# --- Database ---
CONNEXO_DATABASE_URL=postgres://postgres:changeme@localhost:5432/connexo?sslmode=disable
CONNEXO_DB_PASSWORD=changeme

# --- Redis ---
CONNEXO_REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
# Alias also accepted by the API:
# CONNEXO_JWT_SECRET=change-me-to-a-random-64-byte-hex-string
JWT_EXPIRY_HOURS=72

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Aliases also accepted:
# CONNEXO_STORAGE_ENDPOINT=localhost:9000
# CONNEXO_STORAGE_ACCESS_KEY=minioadmin
# CONNEXO_STORAGE_SECRET_KEY=minioadmin

# --- SMTP (Email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- CORS ---
CORS_ALLOWED_ORIGIN=*

# --- Application ---
CONNEXO_HTTP_ADDR=:8080
APP_ENV=development

# --- Frontend (Vite) ---
VITE_API_URL=/api
